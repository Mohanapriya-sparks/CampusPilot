# CampusPilot Environment Configuration Template
# Duplicate this file as .env for local backend/development settings if needed.
# Note: For Flutter client, Firebase configuration is managed via lib/firebase_options.dart.

# Backend Service Configuration (Optional local intelligence server)
API_PORT=8000
API_HOST=127.0.0.1
DEBUG=true

# Firebase Web / Mobile Client Project Identifier
FIREBASE_PROJECT_ID=campuspilot-ai-2026
FIREBASE_AUTH_DOMAIN=campuspilot-ai-2026.firebaseapp.com
FIREBASE_STORAGE_BUCKET=campuspilot-ai-2026.firebasestorage.app

# External API / Future Expansion (Keep actual keys strictly in private environment)
GITHUB_API_TOKEN=your_github_personal_access_token_here
LLM_API_KEY=your_optional_llm_api_key_for_explanations_here
